<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Página Inicial</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
  </head>
  <body class="bg-light">
    <div class="container mt-5">
      <h1 class="text-center mb-4">Bem-vindo à Página Inicial</h1>
      <p class="text-center">Escolha uma das opções abaixo para navegar:</p>

      <ul class="list-group">
        <li class="list-group-item">
          <a href="/produtos" class="btn btn-primary w-100">Listar Produtos</a>
        </li>
        <li class="list-group-item">
          <a href="/doacoes" class="btn btn-primary w-100">Listar Doações</a>
        </li>
        <li class="list-group-item">
          <a href="/produto/novo" class="btn btn-success w-100">Cadastrar Novo Produto</a>
        </li>
        <li class="list-group-item">
          <a href="/cadastro" class="btn btn-success w-100">Cadastrar Novo Cliente</a>
        </li>
        <li class="list-group-item">
          <a href="/update/cliente/1" class="btn btn-warning w-100">Editar Cliente</a>
        </li>
        <li class="list-group-item">
          <a href="/doacao/novo" class="btn btn-danger w-100">Registrar Nova Doação</a>
        </li>
      </ul>
    </div>
    <div class="text-center mt-4">
      <a href="/" class="btn btn-secondary">Voltar para home</a>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>