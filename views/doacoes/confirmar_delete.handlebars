<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Confirmar Exclusão</title>

    <!-- Importação do Bootstrap 5.3.3 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
  </head>
  <body class="bg-light d-flex justify-content-center align-items-center vh-100">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-md-6">
          <div class="card shadow-sm">
            <div class="card-body text-center">
              <h1 class="text-danger mb-4">Confirmar Exclusão</h1>
              <p>Tem certeza de que deseja excluir esta doação?</p>
              <p><strong>Produto:</strong> {{doacao.produto.nome_prod}}</p>
              <p><strong>Cliente:</strong> {{doacao.cliente.nm_clie}}</p>
              <p><strong>Data:</strong> {{doacao.data_doa}}</p>

              <div class="d-flex justify-content-center mt-4">
                <!-- Botão de Confirmação -->
                <form action="/delete/doacao/{{doacao.id_doacao}}" method="POST" class="me-2">
                  <button type="submit" class="btn btn-danger">Sim, excluir</button>
                </form>
                <!-- Botão de Cancelamento -->
                <a href="/doacoes" class="btn btn-secondary">Não, voltar</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Importação do Bootstrap 5.3.3 JavaScript Bundle -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
    <div class="text-center mt-4">
      <a href="/" class="btn btn-secondary">Voltar para home</a>
    </div>
  </body>
</html>