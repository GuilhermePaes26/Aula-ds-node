<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Criar Nova Doação</title>

    <!-- Importação do Bootstrap 5.3.3 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
  </head>
  <body class="bg-light">
    <div class="container mt-5">
      <div class="row justify-content-center">
        <div class="col-md-6">
          <div class="card shadow-sm">
            <div class="card-body">
              <h1 class="text-center mb-4">Criar Nova Doação</h1>
              <form action="/doacao/novo" method="POST">

                <div class="mb-3">
                  <label for="id_clie" class="form-label">Cliente:</label>
                  <select name="id_clie" id="id_clie" class="form-select" required>
                    {{#each clientes}}
                      <option value="{{this.id_clie}}">{{this.nm_clie}}</option>
                    {{/each}}
                  </select>
                </div>

                <div class="mb-3">
                  <label for="id_prod" class="form-label">Produto:</label>
                  <select name="id_prod" id="id_prod" class="form-select" required>
                    {{#each produtos}}
                      <option value="{{this.id_prod}}">{{this.nome_prod}}</option>
                    {{/each}}
                  </select>
                </div>

                <div class="mb-3">
                  <label for="data_doa" class="form-label">Data da Doação:</label>
                  <input type="date" name="data_doa" class="form-control" required />
                </div>

                <div class="mb-3">
                  <label for="qndt_doa" class="form-label">Quantidade:</label>
                  <input type="number" name="qndt_doa" class="form-control" required />
                </div>

                <div class="form-check mb-4">
                  <input type="checkbox" name="reserva_doa" id="reserva_doa" class="form-check-input" />
                  <label for="reserva_doa" class="form-check-label">Reserva</label>
                </div>

                <button type="submit" class="btn btn-primary w-100">Criar Doação</button>
              </form>
            </div>
          </div>
        </div>
      </div>

      <div class="text-center mt-4">
        <a href="/" class="btn btn-secondary">Voltar para home</a>
      </div>
    </div>

    <!-- Importação do Bootstrap 5.3.3 JavaScript Bundle -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
  </body>
</html>