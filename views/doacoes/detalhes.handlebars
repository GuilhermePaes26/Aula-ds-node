<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Detalhes da Doação</title>

    <!-- Importação do Bootstrap 5.3.3 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
  </head>
  <body class="bg-light">
    <div class="container mt-5">
      <div class="row justify-content-center">
        <div class="col-md-10">
          <div class="card shadow-sm">
            <div class="card-body">
              <h1 class="text-center mb-4">Detalhes da Doação</h1>
              <div class="row">
                <!-- Coluna de informações da doação -->
                <div class="col-md-8">
                  <p><strong>Cliente:</strong> {{doacao.cliente.nm_clie}} (CPF: {{doacao.cliente.cpf_clie}})</p>
                  <p><strong>Produto:</strong> {{doacao.produto.nome_prod}}</p>
                  <p><strong>Estado:</strong> {{doacao.produto.estado_prod}}</p>
                  <p><strong>Descrição:</strong> {{doacao.produto.descricao_prod}}</p>
                  <p><strong>Data da Doação:</strong> {{doacao.data_doa}}</p>
                  <p><strong>Quantidade:</strong> {{doacao.qndt_doa}}</p>
                  <p><strong>Reserva:</strong> {{#if doacao.reserva_doa}}Reservado{{else}}Não Reservado{{/if}}</p>
                </div>

                <!-- Coluna de imagem -->
                <div class="col-md-4 d-flex justify-content-center align-items-start">
                  {{#if doacao.produto.imagem}}
                    <img src="/uploads/{{doacao.produto.imagem}}" alt="Imagem do Produto" class="img-fluid rounded" style="max-width: 100%;" />
                  {{else}}
                    <p class="text-muted">Imagem não disponível.</p>
                  {{/if}}
                </div>
              </div>

              <div class="mt-4 d-flex justify-content-between">
                <!-- Botão para alterar a reserva -->
                <form action="/alterar/reserva/{{doacao.id_doacao}}" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-warning">
                    {{#if doacao.reserva_doa}}Cancelar Reserva{{else}}Reservar{{/if}}
                  </button>
                </form>

                <!-- Botão de Editar -->
                <a href="/doacao/editar/{{doacao.id_doacao}}" class="btn btn-primary">Editar Doação</a>

                <!-- Botão de Excluir -->
                <form action="/delete/doacao/{{doacao.id_doacao}}" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-danger">Excluir Doação</button>
                </form>
              </div>

              <!-- Links para navegação -->
              <div class="text-center mt-4">
                <a href="/doacoes" class="btn btn-secondary me-2">Voltar para a lista de doações</a>
                <a href="/" class="btn btn-secondary">Voltar para home</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Importação do Bootstrap 5.3.3 JavaScript Bundle -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
  </body>
</html>