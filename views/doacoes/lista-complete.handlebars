<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lista de Doações</title>

    <!-- Importação do Bootstrap 5.3.3 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
  </head>
  <body class="bg-light">
    <div class="container mt-5">
      <h1 class="text-center mb-5">Lista de Doações</h1>

      <div class="row">
        {{#each doacoes}}
          <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 shadow-sm">
              <div class="card-body">
                <p><strong>Cliente:</strong> {{this.cliente.nm_clie}}</p>
                <p><strong>Produto:</strong> {{this.produto.nome_prod}}</p>
                <p><strong>Data da Doação:</strong> {{this.data_doacao}}</p>

                <!-- Exibir a imagem do produto -->
                {{#if this.produto.imagem}}
                  <p><strong>Imagem do Produto:</strong></p>
                  <div class="d-flex justify-content-center mb-3">
                    <img src="/uploads/{{this.produto.imagem}}" alt="Imagem do Produto" class="img-fluid" style="max-width: 200px;" />
                  </div>
                {{else}}
                  <p class="text-muted">Imagem do produto não disponível.</p>
                {{/if}}

                <!-- Botão para alternar a reserva -->
                <form action="/alterar/reserva/{{this.id_doacao}}" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-warning">
                    {{#if this.reserva_doa}}Cancelar Reserva{{else}}Reservar{{/if}}
                  </button>
                </form>

                <!-- Botão de detalhes -->
                <a href="/doacao/detalhes/{{this.id_doacao}}" class="btn btn-primary ml-2">Ver Detalhes</a>
              </div>
            </div>
          </div>
        {{else}}
          <p class="text-center w-100">Nenhuma doação encontrada.</p>
          <a href="/" class="btn btn-secondary">Voltar para home</a>
        {{/each}}
      </div>

      <div class="text-center mt-4">
        <a href="/" class="btn btn-secondary">Voltar para home</a>
      </div>
    </div>

    <!-- Importação do Bootstrap 5.3.3 JavaScript Bundle -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
  </body>
</html>