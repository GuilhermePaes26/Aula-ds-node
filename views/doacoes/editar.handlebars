<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Editar Doação</title>

    <!-- Importação do Bootstrap 5.3.3 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
  </head>
  <body class="bg-light">
    <div class="container mt-5">
      <div class="row justify-content-center">
        <div class="col-md-6">
          <div class="card shadow-sm">
            <div class="card-body">
              <h1 class="text-center mb-4">Editar Doação</h1>
              
              <!-- Formulário para atualizar a doação -->
              <form action="/update/doacao/{{doacao.id_doacao}}" method="POST">
                
                <div class="mb-3">
                  <label for="qndt_doa" class="form-label">Quantidade:</label>
                  <input
                    type="number"
                    name="qndt_doa"
                    id="qndt_doa"
                    value="{{doacao.qndt_doa}}"
                    class="form-control"
                    required
                  />
                </div>

                <div class="mb-3">
                  <label for="reserva_doa" class="form-label">Reserva:</label>
                  <select name="reserva_doa" id="reserva_doa" class="form-select">
                    <option value="true" {{#if doacao.reserva_doa}}selected{{/if}}>Reservado</option>
                    <option value="false" {{#unless doacao.reserva_doa}}selected{{/unless}}>Não Reservado</option>
                  </select>
                </div>

                <button type="submit" class="btn btn-primary w-100">Atualizar Doação</button>
              </form>

              <!-- Links para navegação -->
              <div class="text-center mt-4">
                <a href="/doacoes" class="btn btn-secondary me-2">Voltar para a lista de doações</a>
                <a href="/" class="btn btn-secondary">Voltar para home</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Importação do Bootstrap 5.3.3 JavaScript Bundle -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
