<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cadastro de Produto</title>

    <!-- Importação do Bootstrap 5.3.3 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
  </head>
  <body class="bg-light">
    <div class="container mt-5">
      <div class="row justify-content-center">
        <div class="col-md-6">
          <div class="card shadow-sm">
            <div class="card-body">
              <h1 class="text-center mb-4">Cadastro de Produto</h1>
              <form action="/produto" method="POST" enctype="multipart/form-data">

                <div class="mb-3">
                  <label for="nome_prod" class="form-label">Nome do Produto:</label>
                  <input type="text" id="nome_prod" name="nome_prod" class="form-control" required />
                </div>

                <div class="mb-3">
                  <label for="estado_prod" class="form-label">Estado do Produto:</label>
                  <input type="text" id="estado_prod" name="estado_prod" class="form-control" required />
                </div>

                <div class="mb-3">
                  <label for="descricao_prod" class="form-label">Descrição do Produto:</label>
                  <textarea id="descricao_prod" name="descricao_prod" class="form-control" required></textarea>
                </div>

                <div class="mb-3">
                  <label for="imagem" class="form-label">Imagem do Produto:</label>
                  <input type="file" id="imagem" name="imagem" class="form-control" accept="image/*" />
                </div>

                <button type="submit" class="btn btn-primary w-100">Cadastrar Produto</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Importação do Bootstrap 5.3.3 JavaScript Bundle -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
    <div class="text-center mt-4">
      <a href="/" class="btn btn-secondary">Voltar para home</a>
    </div>
  </body>
</html>