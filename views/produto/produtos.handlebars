<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lista de Produtos</title>

    <!-- Importação do Bootstrap 5.3.3 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
  </head>
  <body class="bg-light">
    <div class="container mt-5">
      <h1 class="text-center mb-5">Lista de Produtos Disponíveis</h1>

      <div class="row">
        {{#each produtos}}
          <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
              <!-- Imagem do Produto -->
              <img src="/uploads/{{imagem}}" class="card-img-top" alt="Imagem de {{nome_prod}}" style="max-height: 200px; object-fit: cover;" />
              <div class="card-body">
                <h5 class="card-title">{{nome_prod}}</h5>
                <p class="card-text"><strong>Estado:</strong> {{estado_prod}}</p>
                <p class="card-text"><strong>Descrição:</strong> {{descricao_prod}}</p>
                <a href="/produto/{{id_prod}}" class="btn btn-primary w-100">Ver Detalhes</a>
              </div>
            </div>
          </div>
        {{else}}
          <p class="text-center w-100">Nenhum produto encontrado.</p>
        {{/each}}
      </div>
    </div>

    <!-- Importação do Bootstrap 5.3.3 JavaScript Bundle -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
    <div class="text-center mt-4">
      <a href="/" class="btn btn-secondary">Voltar para home</a>
    </div>
  </body>
</html>