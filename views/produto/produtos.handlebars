<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de Produtos</title>
</head>
<body>
    <h1>Lista de Produtos Disponíveis</h1>

    <ul>
        {{#each produtos}}
            <li>
                <h2>{{nome_prod}}</h2>
                <p><strong>Estado:</strong> {{estado_prod}}</p>
                <p><strong>Descrição:</strong> {{descricao_prod}}</p>
                <a href="/produto/{{id_prod}}">Ver Detalhes</a>
            </li>
        {{else}}
            <p>Nenhum produto encontrado.</p>
        {{/each}}
    </ul>
</body>
</html>
