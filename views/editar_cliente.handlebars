<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Editar Cliente</title>

    <!-- Importação do Bootstrap 5.3.3 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
  </head>
  <body class="bg-light">
    <div class="container mt-5">
      <div class="row justify-content-center">
        <div class="col-md-6">
          <div class="card shadow-sm">
            <div class="card-body">
              <h1 class="text-center mb-4">Editar Cliente</h1>
              <form action="/update/cliente/{{cliente.id_clie}}" method="POST">
                <div class="mb-3">
                  <label for="nm_clie" class="form-label">Nome:</label>
                  <input type="text" id="nm_clie" name="nm_clie" value="{{cliente.nm_clie}}" class="form-control" required />
                </div>

                <div class="mb-3">
                  <label for="cpf_clie" class="form-label">CPF:</label>
                  <input type="text" id="cpf_clie" name="cpf_clie" value="{{cliente.cpf_clie}}" class="form-control" required />
                </div>

                <div class="mb-3">
                  <label for="senha_clie" class="form-label">Senha:</label>
                  <input type="password" id="senha_clie" name="senha_clie" value="{{cliente.senha_clie}}" class="form-control" required />
                </div>

                <button type="submit" class="btn btn-primary w-100">Atualizar</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Importação do Bootstrap 5.3.3 JavaScript Bundle -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
    <div class="text-center mt-4">
      <a href="/" class="btn btn-secondary">Voltar para home</a>
    </div>
  </body>
</html>